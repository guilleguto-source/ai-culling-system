{
  "name": "guto-flow",
  "version": "2.1.0",
  "description": "Guto Flow — Smart Workflow: culling y pre-edición de fotos con IA",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:frontend": "vite",
    "dev:electron": "tsc -p tsconfig.json && electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "build:frontend": "vite build",
    "build:electron": "tsc -p tsconfig.json",
    "build:backend": "pyinstaller backend.spec --clean --noconfirm",
    "build:all": "npm run build:frontend && npm run build:electron && npm run build:backend && electron-builder",
    "dist": "npm run build:all",
    "dist:win": "npm run build:all -- --win",
    "test:backend": "pytest backend/tests",
    "verify:build": "python scripts/verify_build.py"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "build": {
    "productName": "Guto Flow",
    "appId": "com.gutogutierrez.gutoflow",
    "copyright": "Copyright © 2025 Guto Gutiérrez",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Guto Flow",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "scripts/installer.nsh",
      "artifactName": "GutoFlow-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}