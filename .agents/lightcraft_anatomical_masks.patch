+/// Synthesizes anatomical segmentation mattes (Person, Skin, EyeSclera, IrisPupil, Teeth)
+/// directly from normalized face bounding boxes (0.0..1.0).
+///
+/// Fully portable across all platforms and versions of LightCraft (CPU reference, zero external dependencies).
+pub fn generate_anatomical_mattes(faces: &[Rect]) -> Mattes {
+    const MW: usize = 512;
+    const MH: usize = 512;
+
+    let default_face = Rect {
+        x0: 0.32,
+        y0: 0.15,
+        x1: 0.68,
+        y1: 0.52,
+    };
+    let face_list: Vec<&Rect> = if faces.is_empty() {
+        vec![&default_face]
+    } else {
+        faces.iter().collect()
+    };
+
+    let mut person_matte = Image::<u8>::new(MW, MH);
+    let mut skin_matte = Image::<u8>::new(MW, MH);
+    let mut sclera_matte = Image::<u8>::new(MW, MH);
+    let mut iris_matte = Image::<u8>::new(MW, MH);
+    let mut teeth_matte = Image::<u8>::new(MW, MH);
+
+    for rect in face_list {
+        let (fx0, fy0, fx1, fy1) = (rect.x0 as f32, rect.y0 as f32, rect.x1 as f32, rect.y1 as f32);
+        let fw = (fx1 - fx0).max(0.04);
+        let fh = (fy1 - fy0).max(0.04);
+
+        let hcx = (fx0 + fx1) * 0.5;
+        let hcy = (fy0 + fy1) * 0.5;
+
+        // 1. Person: Head + Torso
+        let hrx = fw * 0.55;
+        let hry = fh * 0.60;
+        let bcx = hcx;
+        let y_bottom = (fy1 + fh * 2.8).min(0.98);
+        let bcy = (fy1 + y_bottom) * 0.5;
+        let brx = (fw * 1.35).min(0.48);
+        let bry = (y_bottom - fy1) * 0.5;
+
+        // 2. Eyes
+        let l_eye_x = fx0 + fw * 0.33;
+        let r_eye_x = fx0 + fw * 0.67;
+        let eye_y = fy0 + fh * 0.38;
+        let erx = (fw * 0.11).max(0.005);
+        let ery = (fh * 0.065).max(0.003);
+        let r_iris = (fw * 0.046).max(0.003);
+
+        // 3. Mouth / Teeth
+        let mcx = hcx;
+        let mcy = fy0 + fh * 0.77;
+        let mrx = (fw * 0.135).max(0.005);
+        let mry = (fh * 0.040).max(0.003);
+
+        // 4. Facial Skin
+        let srx = fw * 0.46;
+        let sry = fh * 0.52;
+
+        for py in 0..MH {
+            let ny = (py as f32 + 0.5) / MH as f32;
+            for px in 0..MW {
+                let nx = (px as f32 + 0.5) / MW as f32;
+
+                // 1. Person (Head + Torso)
+                let hd = (((nx - hcx) / hrx).powi(2) + ((ny - hcy) / hry).powi(2)).sqrt();
+                let head_a = (1.0 - ((hd - 0.75) / 0.35).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let bd = (((nx - bcx) / brx).powi(2) + ((ny - bcy) / bry.max(0.01)).powi(2)).sqrt();
+                let body_a = (1.0 - ((bd - 0.70) / 0.40).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let person_a = head_a.max(body_a);
+
+                // 2. Iris & Pupil
+                let d_iris_l = (((nx - l_eye_x) / r_iris).powi(2) + ((ny - eye_y) / r_iris).powi(2)).sqrt();
+                let d_iris_r = (((nx - r_eye_x) / r_iris).powi(2) + ((ny - eye_y) / r_iris).powi(2)).sqrt();
+                let iris_l_a = (1.0 - ((d_iris_l - 0.70) / 0.35).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let iris_r_a = (1.0 - ((d_iris_r - 0.70) / 0.35).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let iris_a = iris_l_a.max(iris_r_a);
+
+                // 3. Eye Sclera (Eye ellipse minus Iris)
+                let d_eye_l = (((nx - l_eye_x) / erx).powi(2) + ((ny - eye_y) / ery).powi(2)).sqrt();
+                let d_eye_r = (((nx - r_eye_x) / erx).powi(2) + ((ny - eye_y) / ery).powi(2)).sqrt();
+                let eye_l_a = (1.0 - ((d_eye_l - 0.75) / 0.30).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let eye_r_a = (1.0 - ((d_eye_r - 0.75) / 0.30).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let sclera_l_a = (eye_l_a * (1.0 - iris_l_a * 1.15)).clamp(0.0, 1.0);
+                let sclera_r_a = (eye_r_a * (1.0 - iris_r_a * 1.15)).clamp(0.0, 1.0);
+                let sclera_a = sclera_l_a.max(sclera_r_a);
+
+                // 4. Teeth (Oral aperture)
+                let d_mouth = (((nx - mcx) / mrx).powi(2) + ((ny - mcy) / mry).powi(2)).sqrt();
+                let teeth_a = (1.0 - ((d_mouth - 0.70) / 0.35).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+
+                // 5. Facial Skin (Face contour minus eyes minus mouth)
+                let d_skin = (((nx - hcx) / srx).powi(2) + ((ny - hcy) / sry).powi(2)).sqrt();
+                let base_skin_a = (1.0 - ((d_skin - 0.80) / 0.25).clamp(0.0, 1.0)).clamp(0.0, 1.0);
+                let skin_a = (base_skin_a * (1.0 - eye_l_a) * (1.0 - eye_r_a) * (1.0 - teeth_a)).clamp(0.0, 1.0);
+
+                // Max-composite into respective mattes
+                let p_val = (person_a * 255.0).round() as u8;
+                if p_val > person_matte.get(px, py) {
+                    person_matte.set(px, py, p_val);
+                }
+
+                let s_val = (skin_a * 255.0).round() as u8;
+                if s_val > skin_matte.get(px, py) {
+                    skin_matte.set(px, py, s_val);
+                }
+
+                let sc_val = (sclera_a * 255.0).round() as u8;
+                if sc_val > sclera_matte.get(px, py) {
+                    sclera_matte.set(px, py, sc_val);
+                }
+
+                let ir_val = (iris_a * 255.0).round() as u8;
+                if ir_val > iris_matte.get(px, py) {
+                    iris_matte.set(px, py, ir_val);
+                }
+
+                let t_val = (teeth_a * 255.0).round() as u8;
+                if t_val > teeth_matte.get(px, py) {
+                    teeth_matte.set(px, py, t_val);
+                }
+            }
+        }
+    }
+
+    let mut mattes = Mattes::default();
+    mattes.push(MatteKind::Person, person_matte);
+    mattes.push(MatteKind::Skin, skin_matte);
+    mattes.push(MatteKind::EyeSclera, sclera_matte);
+    mattes.push(MatteKind::IrisPupil, iris_matte);
+    mattes.push(MatteKind::Teeth, teeth_matte);
+    mattes
+}
+
